<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/stocdex_background_light">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StocDex"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/stocdex_teal_primary"
            android:layout_marginTop="48dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage stock with ease"
            android:textSize="14sp"
            android:textColor="@color/stocdex_sage"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/inputEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:background="@android:drawable/edit_text" />

        <TextView
            android:id="@+id/textForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot password? OTP reset"
            android:textColor="@color/stocdex_teal_primary"
            android:layout_gravity="end"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sign in"
            android:backgroundTint="@color/stocdex_teal_primary"
            android:textColor="@android:color/white"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>