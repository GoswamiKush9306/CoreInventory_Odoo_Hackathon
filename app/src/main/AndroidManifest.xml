<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.stocdex">

    <application
        android:allowBackup="true"
        android:label="StocDex"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.StocDex">
        <activity android:name=".ui.profile.ProfileActivity" />
        <activity android:name=".ui.settings.SettingsActivity" />
        <activity android:name=".ui.operations.AdjustmentsActivity" />
        <activity android:name=".ui.operations.TransfersActivity" />
        <activity android:name=".ui.operations.DeliveryActivity" />
        <activity android:name=".ui.operations.ReceiptsActivity" />
        <activity android:name=".ui.documents.DocumentsActivity" />
        <activity android:name=".ui.products.AddProductActivity" />
        <activity android:name=".ui.products.ProductsActivity" />
        <activity android:name=".ui.dashboard.DashboardActivity" />
        <activity android:name=".ui.auth.OtpResetActivity" />
        <activity android:name=".ui.auth.LoginActivity" />
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>